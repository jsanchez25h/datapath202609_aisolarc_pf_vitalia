        <mxCell id="D01n49" value="&lt;b&gt;EMPRESA CONTRATANTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Su trabajador falta y se&lt;br&gt;queja ante RR.HH.&lt;br&gt;&lt;br&gt;_Insatisfaccion del cliente&lt;br&gt;B2B que paga la factura_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="64" y="734" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="D01n50" value="&lt;b&gt;COMERCIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;En la renovacion anual&lt;br&gt;RR.HH. recuerda el caso&lt;br&gt;&lt;br&gt;_Riesgo de churn de una&lt;br&gt;cuenta completa: cientos&lt;br&gt;de afiliados a la vez_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="382" y="734" width="300" height="140" as="geometry"/></mxCell>
