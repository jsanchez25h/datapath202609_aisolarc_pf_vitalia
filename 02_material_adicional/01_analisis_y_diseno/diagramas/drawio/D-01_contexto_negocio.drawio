        <mxCell id="D01n52" value="&lt;b&gt;CUMPLIMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada reversion abre un&lt;br&gt;expediente de reclamo&lt;br&gt;&lt;br&gt;_Exposicion regulatoria&lt;br&gt;y sancionatoria_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1018" y="734" width="300" height="140" as="geometry"/></mxCell>
