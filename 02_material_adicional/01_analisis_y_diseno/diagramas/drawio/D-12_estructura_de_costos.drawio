        <mxCell id="D12n118" value="EFECTO EN EL RETORNO      valor capturable sin cambios: S/ 96,600 / mes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="762" width="766" height="24" as="geometry"/></mxCell>
