        <mxCell id="D12n120" value="VAN @ 12%  ·  3 anios&lt;br&gt;&lt;b&gt;S/ 1.17 M&lt;/b&gt;&lt;br&gt;era S/ 1.13 M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="792" width="246" height="62" as="geometry"/></mxCell>
        <mxCell id="D12n121" value="TIR&lt;br&gt;&lt;b&gt;88%&lt;/b&gt;&lt;br&gt;era 85%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="580" y="792" width="246" height="62" as="geometry"/></mxCell>
        <mxCell id="D12n122" value="&lt;b&gt;La diferencia NO se descuenta.&lt;/b&gt;   El costo de run comprometido sigue siendo S/ 21,700 / mes y los S/ 2,000 quedan&lt;br&gt;como contingencia hasta que tres meses de facturacion etiquetada lo confirmen.   Lo que si corrige el costeo es el&lt;br&gt;&lt;b&gt;reparto&lt;/b&gt;: se presupuesto 3.4x de mas en inferencia y de menos en conectividad  -  VPN, PSC, NAT e instancias minimas&lt;br&gt;suman S/ 1,480 / mes, mas del doble que toda la inferencia junta." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="864" width="766" height="80" as="geometry"/></mxCell>
        <mxCell id="D12n123" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BF8F00;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="862" y="576" width="790" height="379" as="geometry"/></mxCell>
