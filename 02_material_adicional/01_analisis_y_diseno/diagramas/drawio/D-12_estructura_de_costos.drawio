        <mxCell id="D12n166" value="Precio de lista publico, region us-central1, tarifas consultadas&lt;br&gt;el 2026-09-05.  Tipo de cambio declarado: S/ 3.75 por USD.&lt;br&gt;Model Armor, Vertex AI Ranking e Identity Platform van estimados:&lt;br&gt;falta confirmarlos en el calculador de Google Cloud.&lt;br&gt;Detalle servicio por servicio, drivers y controles FinOps en&lt;br&gt;05a_costeo_cloud.md." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="750" y="1017" width="310" height="98" as="geometry"/></mxCell>
