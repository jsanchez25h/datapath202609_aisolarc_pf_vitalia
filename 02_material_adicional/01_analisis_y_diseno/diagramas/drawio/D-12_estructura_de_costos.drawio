        <mxCell id="D12n154" value="linea de presupuesto  S/ 8,700" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=7;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1150" y="844" width="200" height="16" as="geometry"/></mxCell>
        <mxCell id="D12n155" value="**El unico escenario que rompe el presupuesto es una decision comercial de Google, no una necesidad tecnica de&lt;br&gt;este volumen.**   Cloud Armor Standard cubre WAF, reglas y limitacion de tasa para las 7,800 solicitudes al mes de&lt;br&gt;Vitalia; Enterprise solo se justifica si aparece exposicion real a denegacion de servicio.   Todo lo demas cabe&lt;br&gt;dentro de los S/ 8,700 ya presupuestados." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#BF8F00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="874" y="866" width="766" height="78" as="geometry"/></mxCell>
