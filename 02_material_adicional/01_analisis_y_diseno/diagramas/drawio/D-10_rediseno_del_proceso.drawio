        <mxCell id="D10n2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F3864;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="28" y="28" width="1644" height="1094" as="geometry"/></mxCell>
        <mxCell id="D10n3" value="REDISENO DEL PROCESO  -  DE OCHO SUB-PROCESOS A CUATRO ESTADOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="28" y="28" width="1644" height="46" as="geometry"/></mxCell>
        <mxCell id="D10n4" value="&lt;b&gt;PROCESO ACTUAL  -  ocho sub-procesos&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="592" height="34" as="geometry"/></mxCell>
        <mxCell id="D10n5" value="&lt;b&gt;ACCION DE REDISENO&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="100" width="260" height="34" as="geometry"/></mxCell>
        <mxCell id="D10n6" value="&lt;b&gt;PROCESO REDISENADO&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="100" width="720" height="34" as="geometry"/></mxCell>
        <mxCell id="D10n7" value="S1  ·  Recepcion y normalizacion de la solicitud&lt;br&gt;Formulario libre que acepta cualquier cosa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="142" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n8" value="&lt;b&gt;ELIMINAR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A61C00;fontColor=#A61C00;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="142" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n9" value="La solicitud &lt;b&gt;nace estructurada&lt;/b&gt; en N1: el medico elige del&lt;br&gt;catalogo, no escribe texto libre. No hay nada que normalizar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="142" width="720" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n10" value="S2  ·  Extraccion de datos del PDF&lt;br&gt;4 min de transcripcion manual  ·  21% del esfuerzo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="200" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n11" value="**REDUCIR&lt;br&gt;ALCANCE**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BF8F00;fontColor=#BF8F00;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="200" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n12" value="&lt;b&gt;E1 · EXTRACCION&lt;/b&gt;  sobrevive solo para documentos clinicos.&lt;br&gt;Los campos administrativos ya vienen capturados desde N1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="200" width="720" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n13" value="S3  ·  Verificacion de sustento completo&lt;br&gt;Se descubre a las 24 h  ·  23% observaciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="258" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n14" value="**ELIMINAR&lt;br&gt;EL ESTADO**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A61C00;fontColor=#A61C00;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="258" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n15" value="&quot;Observacion&quot; deja de ser un estado del expediente y pasa a ser&lt;br&gt;una &lt;b&gt;condicion de envio&lt;/b&gt;. No hay carta de observacion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="258" width="720" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n16" value="S4  ·  Vigencia, plan, deuda, acumulado&lt;br&gt;3 min en dos pantallas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="316" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n17" value="&lt;b&gt;UNIFICAR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#548235;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="316" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n18" value="S5  ·  Carencia y preexistencia&lt;br&gt;2 min de aritmetica manual" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="374" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n19" value="&lt;b&gt;UNIFICAR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#548235;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="374" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n20" value="S6  ·  Cobertura, exclusion y copago&lt;br&gt;7 min buscando en el manual  ·  37% del esfuerzo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="432" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n21" value="&lt;b&gt;UNIFICAR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#548235;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="432" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n22" value="S7  ·  Casos limite&lt;br&gt;Derivacion defensiva: 55% no requeria criterio clinico" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="490" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n23" value="&lt;b&gt;REDISTRIBUIR&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#7030A0;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="490" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n24" value="&lt;b&gt;E3 · RUTEO MEDIDO&lt;/b&gt;  lo hace el sistema por umbral, no el&lt;br&gt;analista por miedo. El auditor deja de ser valvula de escape" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="490" width="720" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n25" value="S8  ·  Emision de la carta&lt;br&gt;Copiado a mano desde tres pantallas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="548" width="592" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n26" value="&lt;b&gt;ABSORBER&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#548235;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=2;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="656" y="548" width="260" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n27" value="En el carril automatico decidir y emitir son el &lt;b&gt;mismo acto&lt;/b&gt;.&lt;br&gt;&lt;b&gt;E4&lt;/b&gt; solo es un estado cuando hay firma humana que esperar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="548" width="720" height="52" as="geometry"/></mxCell>
        <mxCell id="D10n28" value="&lt;b&gt;E2  ·  ADJUDICACION UNIFICADA DE POLIZA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Una sola evaluacion devuelve elegibilidad + carencia + cobertura +&lt;br&gt;exclusion + copago, con la cita textual de la version vigente.&lt;br&gt;&lt;br&gt;Estaban separados porque eran &lt;b&gt;tres pantallas y tres personas&lt;/b&gt;,&lt;br&gt;no porque sean tres decisiones." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6DCE5;strokeColor=#1F3864;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="932" y="316" width="720" height="168" as="geometry"/></mxCell>
        <mxCell id="D10n29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="622" width="1604" height="182" as="geometry"/></mxCell>
        <mxCell id="D10n30" value="LOS PASOS QUE NO EXISTIAN  -  un rediseno que solo quita pasos es un recorte, no un rediseno" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=#C55A11;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="48" y="622" width="1604" height="30" as="geometry"/></mxCell>
        <mxCell id="D10n31" value="&lt;b&gt;N1&lt;/b&gt;&lt;br&gt;RESPUESTA DE COBERTURA&lt;br&gt;EN EL PUNTO DE LA ORDEN&lt;br&gt;&lt;br&gt;Responde antes de que exista la&lt;br&gt;solicitud, con cita y copago estimado.&lt;br&gt;&lt;br&gt;Lo habilita: que responder cueste&lt;br&gt;centimos y no 7 minutos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="305" height="130" as="geometry"/></mxCell>
        <mxCell id="D10n32" value="&lt;b&gt;N2&lt;/b&gt;&lt;br&gt;AUTORIZACION&lt;br&gt;POR EPISODIO&lt;br&gt;&lt;br&gt;El esquema oncologico o el plan de&lt;br&gt;terapias, autorizado una vez.&lt;br&gt;&lt;br&gt;Lo habilita: que revalidar la&lt;br&gt;elegibilidad sea gratis." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="379" y="660" width="305" height="130" as="geometry"/></mxCell>
        <mxCell id="D10n33" value="&lt;b&gt;N3&lt;/b&gt;&lt;br&gt;ESTIMACION DE COSTO&lt;br&gt;AL AFILIADO&lt;br&gt;&lt;br&gt;El copago de bolsillo, antes del&lt;br&gt;procedimiento.&lt;br&gt;&lt;br&gt;Lo habilita: el motor determinista&lt;br&gt;ya calcula el numero." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="698" y="660" width="305" height="130" as="geometry"/></mxCell>
        <mxCell id="D10n34" value="&lt;b&gt;N4&lt;/b&gt;&lt;br&gt;CURADURIA DE LA POLITICA&lt;br&gt;como proceso continuo&lt;br&gt;&lt;br&gt;Rol nuevo. Cada endoso se publica&lt;br&gt;con version, vigencia y diff.&lt;br&gt;&lt;br&gt;Sin el, no se sostienen R2 ni F4." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1016" y="660" width="305" height="130" as="geometry"/></mxCell>
        <mxCell id="D10n35" value="&lt;b&gt;N5&lt;/b&gt;&lt;br&gt;EXENCION POR DESEMPENO&lt;br&gt;del prestador (gold-carding)&lt;br&gt;&lt;br&gt;Ataca el volumen de entrada, no su&lt;br&gt;costo unitario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision del sponsor.&lt;/b&gt; El sistema&lt;br&gt;produce el dato; no toma la decision." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1335" y="660" width="305" height="130" as="geometry"/></mxCell>
        <mxCell id="D10n36" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="820" width="852" height="145" as="geometry"/></mxCell>
        <mxCell id="D10n37" value="LO QUE SE EVALUO Y SE MANTIENE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7F7F7F;strokeColor=#7F7F7F;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="48" y="820" width="852" height="26" as="geometry"/></mxCell>
        <mxCell id="D10n38" value="Fusionar el guardrail dentro de E1  -&gt;  &lt;b&gt;NO.&lt;/b&gt; Debe correr antes de que el contenido toque un modelo.&lt;br&gt;Fusionar el ruteo (E3) con la adjudicacion (E2)  -&gt;  &lt;b&gt;NO.&lt;/b&gt; Consumen insumos distintos.&lt;br&gt;Que el agente absorba el ruteo  -&gt;  &lt;b&gt;NO.&lt;/b&gt; Volveria a poner lo no determinista en la decision (veto V1).&lt;br&gt;Eliminar el control humano en casos limite  -&gt;  &lt;b&gt;NUNCA.&lt;/b&gt; Es el invariante R3.&lt;br&gt;Reducir las 8 capas de guardrail  -&gt;  &lt;b&gt;NO.&lt;/b&gt; El orden barato-&gt;caro ya las hace baratas.&lt;br&gt;&lt;br&gt;&lt;b&gt;El HITL es el unico paso que se conserva por razones que no son de eficiencia.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="852" width="828" height="105" as="geometry"/></mxCell>
        <mxCell id="D10n39" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="916" y="820" width="736" height="145" as="geometry"/></mxCell>
        <mxCell id="D10n40" value="EFECTO SOBRE EL PROCESO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="916" y="820" width="736" height="26" as="geometry"/></mxCell>
        <mxCell id="D10n41" value="Sub-procesos / estados de negocio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="928" y="852" width="380" height="26" as="geometry"/></mxCell>
        <mxCell id="D10n42" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1308" y="852" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="D10n43" value="&lt;b&gt;4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1458" y="852" width="182" height="26" as="geometry"/></mxCell>
