        <mxCell id="D09n104" value="Los meses son relativos al inicio del proyecto, no calendario.&lt;br&gt;F2 se ejecuta en modo sombra: el sistema propone y el analista&lt;br&gt;decide, midiendo el acuerdo contra el golden set antes de&lt;br&gt;habilitar cualquier resolucion automatica." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="750" y="1017" width="310" height="98" as="geometry"/></mxCell>
