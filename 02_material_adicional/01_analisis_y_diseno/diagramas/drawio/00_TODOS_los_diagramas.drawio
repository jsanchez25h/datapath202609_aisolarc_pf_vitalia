        <mxCell id="D08n15" value="&lt;b&gt;CAPA 6&lt;/b&gt;&lt;br&gt;URL y phishing&lt;br&gt;&lt;br&gt;60+ TLDs, 20+ acortadores&lt;br&gt;&lt;br&gt;_listas_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1058" y="144" width="190" height="96" as="geometry"/></mxCell>
