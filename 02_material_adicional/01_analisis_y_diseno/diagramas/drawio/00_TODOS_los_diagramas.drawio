        <mxCell id="D08n19" value="&lt;b&gt;CAPA 8&lt;/b&gt;&lt;br&gt;Llama Guard 4&lt;br&gt;&lt;br&gt;safe / unsafe  ·  S1-S13&lt;br&gt;&lt;br&gt;_modelo 12B_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1462" y="144" width="190" height="96" as="geometry"/></mxCell>
        <mxCell id="D08e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#A61C00;strokeWidth=1.5;fontSize=8;fontFamily=Helvetica;fontColor=#A61C00;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D08n17" target="D08n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D08n21" value="DECISIONES:   &lt;b&gt;PERMITIR&lt;/b&gt;   ·   &lt;b&gt;TRANSFORMAR&lt;/b&gt; (enmascarar el dato sensible)   ·   &lt;b&gt;CONFIRMAR&lt;/b&gt; (pide confirmacion al usuario)   ·   &lt;b&gt;BLOQUEAR&lt;/b&gt;        |        Registro: capa = pii · categoria = dni · decision = mask · confianza = alta     (nunca se registra el valor completo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="250" width="1604" height="38" as="geometry"/></mxCell>
        <mxCell id="D08n22" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="320" width="790" height="260" as="geometry"/></mxCell>
        <mxCell id="D08n23" value="2  ·  CONTROL HUMANO EN EL CIRCUITO (HITL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="48" y="320" width="790" height="32" as="geometry"/></mxCell>
        <mxCell id="D08n24" value="&lt;b&gt;GATE DE APROBACION&lt;/b&gt;&lt;br&gt;&lt;br&gt;La emision de la carta no ocurre&lt;br&gt;sin aprobacion cuando el caso&lt;br&gt;cae fuera del carril automatico." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n25" value="&lt;b&gt;UMBRAL DE CONFIANZA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si la confianza de la extraccion&lt;br&gt;o de la cita cae bajo el umbral,&lt;br&gt;escala al medico auditor." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="320" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n26" value="&lt;b&gt;FLUJO DE ESCALAMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preexistencia, exclusion con&lt;br&gt;excepcion encadenada, extranjero&lt;br&gt;y procedimiento no listado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="580" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n27" value="&lt;b&gt;INVARIANTE DE CUMPLIMIENTO&lt;/b&gt;&lt;br&gt;Ninguna negacion por necesidad medica se emite sin la firma de un medico colegiado.&lt;br&gt;Se adopta aunque el Peru todavia no lo exija: es la direccion de la norma comparada (SB 1120) y es lo que mas sanciona SUSALUD." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="494" width="766" height="70" as="geometry"/></mxCell>
        <mxCell id="D08n28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7030A0;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="862" y="320" width="790" height="260" as="geometry"/></mxCell>
        <mxCell id="D08n29" value="3  ·  TRAZABILIDAD Y VERSIONADO DE LA POLITICA   (falla F4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=#7030A0;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="862" y="320" width="790" height="32" as="geometry"/></mxCell>
        <mxCell id="D08n30" value="&lt;b&gt;POLITICA VERSIONADA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada endoso se publica como vN&lt;br&gt;con sha256, vigencia_desde,&lt;br&gt;vigencia_hasta y diff contra vN-1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="874" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n31" value="&lt;b&gt;SELLO EN LA DECISION&lt;/b&gt;&lt;br&gt;&lt;br&gt;La carta emitida guarda la version&lt;br&gt;aplicada y las citas textuales&lt;br&gt;que la sustentan." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1134" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n32" value="&lt;b&gt;RECONSTRUCCION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Seis meses despues se puede&lt;br&gt;responder: por que se nego, con&lt;br&gt;que regla y quien lo firmo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1394" y="364" width="246" height="116" as="geometry"/></mxCell>
        <mxCell id="D08n33" value="&lt;b&gt;POR QUE IMPORTA&lt;/b&gt;&lt;br&gt;Es exactamente lo que un tribunal exigio en el caso nH Predict y lo que SUSALUD pide en una fiscalizacion.&lt;br&gt;Sin esto, la solucion puede acertar y aun asi ser indefendible." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7030A0;strokeColor=#7030A0;fontColor=#FFFFFF;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="874" y="494" width="766" height="70" as="geometry"/></mxCell>
