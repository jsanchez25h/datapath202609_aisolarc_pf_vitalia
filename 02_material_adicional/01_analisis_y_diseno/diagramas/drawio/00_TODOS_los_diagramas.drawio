        <mxCell id="D04n3" value="PROCESO OBJETIVO (TO-BE)  -  TRES CARRILES, CUATRO ESTADOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="28" y="28" width="1644" height="46" as="geometry"/></mxCell>
        <mxCell id="D04n4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="1102" height="100" as="geometry"/></mxCell>
        <mxCell id="D04n5" value="CARRIL 0  ·  EN EL PUNTO DE LA ORDEN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C55A11;strokeColor=#C55A11;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="1102" height="26" as="geometry"/></mxCell>
        <mxCell id="D04n6" value="&lt;b&gt;N1  ·  CONSULTA DE COBERTURA ANTICIPADA&lt;/b&gt;      RAG con cita  +  motor de copago  ·  &lt;b&gt;CAPACIDAD NUEVA&lt;/b&gt;&lt;br&gt;Al elegir diagnostico + procedimiento + plan el portal RESPONDE antes de que exista la solicitud: cubierto / no cubierto / falta el sustento X,&lt;br&gt;con la cita textual de la politica vigente y el copago estimado al afiliado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="1078" height="58" as="geometry"/></mxCell>
        <mxCell id="D04n7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="482" height="100" as="geometry"/></mxCell>
        <mxCell id="D04n8" value="CARRIL 2  ·  EPISODIO   (fase condicional)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7F7F7F;strokeColor=#7F7F7F;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1170" y="100" width="482" height="26" as="geometry"/></mxCell>
        <mxCell id="D04n9" value="&lt;b&gt;N2  ·  AUTORIZACION POR EPISODIO&lt;/b&gt;  ·  CAPACIDAD NUEVA&lt;br&gt;El esquema oncologico o el plan de terapias se autoriza una vez,&lt;br&gt;con control de consumo y revalidacion automatica de elegibilidad.&lt;br&gt;&lt;b&gt;Requiere endoso a la poliza, no un componente mas&lt;/b&gt;   ~ -1,400 sol./mes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1182" y="132" width="458" height="58" as="geometry"/></mxCell>
        <mxCell id="D04n10" value="&lt;b&gt;AUTORIZADO EN EL ACTO&lt;/b&gt;   caso limpio con sustento adjunto  -&gt;  cero toques, cero cola" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="218" width="540" height="44" as="geometry"/></mxCell>
        <mxCell id="D04e11" value="caso limpio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#548235;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#548235;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n6" target="D04n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n12" value="&lt;b&gt;GUARDRAIL DE ENTRADA  ·  8 capas barato -&gt; caro  ·  fail-close&lt;/b&gt;&lt;br&gt;secretos · inyeccion · toxicidad · regex · PII (DNI/RUC/telefono PE) · URL y phishing · Prompt Guard · Llama Guard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="640" y="218" width="1012" height="44" as="geometry"/></mxCell>
        <mxCell id="D04e13" value="no resoluble aqui  -&gt;  CARRIL 1  ·  EXPEDIENTE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n6" target="D04n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n14" value="&lt;b&gt;E1  ·  EXTRACCION&lt;/b&gt;      con IA  (D3)      -  solo documentos clinicos: informe, examenes, riesgo anestesico&lt;br&gt;Los campos administrativos ya no se extraen: vienen capturados desde N1.  Validacion contra catalogo: campo no validado = no se autocompleta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="640" y="282" width="1012" height="58" as="geometry"/></mxCell>
        <mxCell id="D04e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n12" target="D04n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="362" width="1604" height="148" as="geometry"/></mxCell>
        <mxCell id="D04n17" value="E2  ·  ADJUDICACION UNIFICADA DE POLIZA        una sola evaluacion  &lt;-  fusiona S4 + S5 + S6 del proceso actual" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=12;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="48" y="362" width="1604" height="30" as="geometry"/></mxCell>
        <mxCell id="D04n18" value="&lt;b&gt;PARTE DETERMINISTA  ·  SIN IA&lt;/b&gt;      63% de la evaluacion&lt;br&gt;&lt;br&gt;Elegibilidad (D1): Acredita Salud + sistema central, deuda, acumulado y tope de bolsillo&lt;br&gt;Carencia y preexistencia (D2): tabla cerrada 0/30/60/90/180/300 dias calendario&lt;br&gt;Copago (D2): plan x tipo de atencion x nivel de clinica x acumulado x tope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="64" y="400" width="790" height="96" as="geometry"/></mxCell>
        <mxCell id="D04n19" value="&lt;b&gt;PARTE INTERPRETATIVA  ·  CON IA&lt;/b&gt;      (D4 + veto V2)&lt;br&gt;&lt;br&gt;Cobertura y exclusiones redactadas en prosa, resueltas por RAG hibrido&lt;br&gt;(denso + BM25) sobre la version de la politica vigente ese dia&lt;br&gt;&lt;b&gt;CITA TEXTUAL OBLIGATORIA  -  sin cita no hay afirmacion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="870" y="400" width="766" height="96" as="geometry"/></mxCell>
        <mxCell id="D04e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n14" target="D04n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n21" value="Estaban separados porque eran tres pantallas y tres personas, no porque sean tres decisiones.  La fusion es rediseno de proceso, no optimizacion." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="520" width="1604" height="26" as="geometry"/></mxCell>
        <mxCell id="D04n22" value="&lt;b&gt;E3  ·  RUTEO MEDIDO&lt;/b&gt;      reemplaza la derivacion defensiva del analista&lt;br&gt;por umbral de confianza, exclusion detectada y necesidad real de criterio clinico" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="450" y="560" width="800" height="52" as="geometry"/></mxCell>
        <mxCell id="D04e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n18" target="D04n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n19" target="D04n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n25" value="&lt;b&gt;CARRIL AUTOMATICO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confianza alta, sin exclusion,&lt;br&gt;sin criterio clinico requerido&lt;br&gt;&lt;br&gt;&lt;b&gt;Decidir y emitir son el MISMO acto&lt;/b&gt;&lt;br&gt;Meta: 55-60% del volumen  (hoy 0%)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="640" width="500" height="132" as="geometry"/></mxCell>
        <mxCell id="D04n26" value="&lt;b&gt;CONTROL HUMANO (HITL)&lt;/b&gt;&lt;br&gt;MEDICO AUDITOR&lt;br&gt;&lt;br&gt;Recibe el expediente ya armado,&lt;br&gt;con la cita de la politica a la vista&lt;br&gt;&lt;br&gt;**Ninguna negacion por necesidad&lt;br&gt;medica se emite sin su firma**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="600" y="640" width="500" height="132" as="geometry"/></mxCell>
        <mxCell id="D04n27" value="&lt;b&gt;AGENTE DE SUBSANACION&lt;/b&gt;&lt;br&gt;UNICO AGENTE DE LA SOLUCION&lt;br&gt;&lt;br&gt;Decide que falta, a quien pedirlo,&lt;br&gt;revisa lo que llega y reevalua&lt;br&gt;&lt;br&gt;&lt;b&gt;EN SESION&lt;/b&gt;, no como carta de&lt;br&gt;observacion 24 h despues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1152" y="640" width="500" height="132" as="geometry"/></mxCell>
        <mxCell id="D04e28" value="automatico" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#548235;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#548235;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n22" target="D04n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04e29" value="criterio clinico&lt;br&gt;o negacion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#548235;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#548235;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n22" target="D04n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04e30" value="falta sustento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#C55A11;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n22" target="D04n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n31" value="&lt;b&gt;E4  ·  EMISION CON SELLO&lt;/b&gt;      transaccional + gate de aprobacion&lt;br&gt;Carta y carta de garantia  ·  &lt;b&gt;sello de la version de politica y de las citas usadas&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="450" y="800" width="800" height="56" as="geometry"/></mxCell>
        <mxCell id="D04e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n25" target="D04n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n26" target="D04n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04e34" value="expediente&lt;br&gt;completo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#C55A11;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#C55A11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n27" target="D04n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n35" value="&lt;b&gt;TRAZA INMUTABLE  -  responde a la falla F4&lt;/b&gt;      que se decidio  ·  con que version de politica  ·  que se cito textualmente  ·  quien firmo  ·  cuanto costo&lt;br&gt;reconstruible ante SUSALUD seis meses despues" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9DFF3;strokeColor=#7030A0;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="876" width="1604" height="44" as="geometry"/></mxCell>
        <mxCell id="D04e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1F3864;strokeWidth=1.5;fontSize=10;fontFamily=Helvetica;fontColor=#1F3864;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="D04n31" target="D04n35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="D04n37" value="&lt;b&gt;SUB-PROCESOS&lt;/b&gt;    8  -&gt;  &lt;b&gt;4 estados&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="930" width="308" height="34" as="geometry"/></mxCell>
        <mxCell id="D04n38" value="&lt;b&gt;AUTOMATIZACION (STP)&lt;/b&gt;    0%  -&gt;  &lt;b&gt;55-60%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="372" y="930" width="308" height="34" as="geometry"/></mxCell>
        <mxCell id="D04n39" value="&lt;b&gt;TIEMPO DE TRABAJO&lt;/b&gt;    19 min  -&gt;  &lt;b&gt;7 min&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="696" y="930" width="308" height="34" as="geometry"/></mxCell>
        <mxCell id="D04n40" value="&lt;b&gt;OBSERVACIONES TARDIAS&lt;/b&gt;    23%  -&gt;  &lt;b&gt;&lt;= 9%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1020" y="930" width="308" height="34" as="geometry"/></mxCell>
