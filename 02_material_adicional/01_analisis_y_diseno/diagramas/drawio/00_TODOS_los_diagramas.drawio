        <mxCell id="D09n77" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1050" y="454" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="D09n78" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D0D0;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1150" y="454" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="D09n79" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1.5;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1056" y="466" width="188" height="36" as="geometry"/></mxCell>
        <mxCell id="D09n80" value="S/ 60,000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1260" y="454" width="196" height="60" as="geometry"/></mxCell>
        <mxCell id="D09n81" value="incremental sobre F3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1456" y="454" width="196" height="60" as="geometry"/></mxCell>
        <mxCell id="D09n82" value="HITOS EXTERNOS Y DEPENDENCIAS QUE NO CONTROLA EL PROYECTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A61C00;strokeColor=#A61C00;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="48" y="530" width="1604" height="32" as="geometry"/></mxCell>
        <mxCell id="D09n83" value="&lt;b&gt;ACREDITA SALUD  -  31 de octubre de 2026&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fecha limite regulatoria de SUSALUD para el intercambio&lt;br&gt;electronico de afiliacion, plan y cobertura.&lt;br&gt;Si a la fecha de arranque Vitalia aun no ha migrado, la&lt;br&gt;integracion deja de ser parte de F1 y pasa a ser un frente&lt;br&gt;independiente de cumplimiento, adelantado a M1." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="574" width="524" height="150" as="geometry"/></mxCell>
        <mxCell id="D09n84" value="&lt;b&gt;DECISION PENDIENTE DEL SPONSOR  -  gold-carding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eximir de preautorizacion al prestador con &gt;= 90% de&lt;br&gt;aprobacion sostenida. Ataca el VOLUMEN, no el costo unitario.&lt;br&gt;No requiere arquitectura nueva: consume las metricas que&lt;br&gt;el propio sistema produce. Compite por el mismo presupuesto&lt;br&gt;y debe decidirse antes de cerrar el alcance." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="588" y="574" width="524" height="150" as="geometry"/></mxCell>
        <mxCell id="D09n85" value="&lt;b&gt;SUPUESTOS A VALIDAR ANTES DE F2&lt;/b&gt;&lt;br&gt;&lt;br&gt;La concentracion del 71% del volumen en 24 combinaciones&lt;br&gt;diagnostico-procedimiento, y el 55% de derivacion defensiva.&lt;br&gt;De esos dos numeros depende la meta de automatizacion.&lt;br&gt;F0 y F1 no dependen de ellos: el piso del caso de negocio&lt;br&gt;esta en la parte que no lleva IA." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1128" y="574" width="524" height="150" as="geometry"/></mxCell>
        <mxCell id="D09n86" value="RESULTADO ACUMULADO DEL PROGRAMA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#548235;strokeColor=#548235;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="48" y="750" width="1604" height="32" as="geometry"/></mxCell>
        <mxCell id="D09n87" value="&lt;b&gt;COSTO ACTUAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;S/ 235,200 / mes&lt;br&gt;S/ 2.82 M / ano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n88" value="&lt;b&gt;VALOR POTENCIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;S/ 155,200 / mes&lt;br&gt;S/ 1.86 M / ano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="318" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n89" value="&lt;b&gt;VALOR CAPTURABLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;S/ 96,600 / mes&lt;br&gt;S/ 1.16 M / ano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="587" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n90" value="&lt;b&gt;COSTO DE OPERAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;S/ 21,700 / mes&lt;br&gt;S/ 260 K / ano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="857" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n91" value="&lt;b&gt;VALOR NETO&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;S/ 74,900 / mes&lt;/b&gt;&lt;br&gt;S/ 0.90 M / ano" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1127" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n92" value="&lt;b&gt;INVERSION Y RETORNO&lt;/b&gt;&lt;br&gt;&lt;br&gt;S/ 660,000&lt;br&gt;&lt;b&gt;payback 8.8 meses&lt;/b&gt;&lt;br&gt;VAN@12% ~ S/ 1.13 M  ·  TIR ~ 85%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1396" y="794" width="256" height="84" as="geometry"/></mxCell>
        <mxCell id="D09n93" value="&lt;b&gt;LA SECUENCIA ES EL ARGUMENTO:&lt;/b&gt;   la fase que NO lleva IA se paga en 3.5 meses; la que si la lleva tarda 12.   Ambas valen la pena, pero en ese orden.&lt;br&gt;Invertir la secuencia habria triplicado el tiempo hasta el primer retorno.   En el escenario pesimista el proyecto sigue positivo (payback 12.6 meses) y el 75% del valor capturable sigue viniendo del motor de copago determinista." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF8F00;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="896" width="1604" height="56" as="geometry"/></mxCell>
        <mxCell id="D09n94" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#000000;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="28" y="985" width="1052" height="137" as="geometry"/></mxCell>
        <mxCell id="D09n95" value="LEYENDA  /  NOTAS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#1F3864;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="28" y="985" width="1052" height="26" as="geometry"/></mxCell>
