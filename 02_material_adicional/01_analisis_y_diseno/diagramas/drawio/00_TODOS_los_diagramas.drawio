        <mxCell id="D03n67" value="DECISION DE CABECERA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3864;strokeColor=#1F3864;fontColor=#FFFFFF;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;fontStyle=1;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="850" y="715" width="802" height="30" as="geometry"/></mxCell>
        <mxCell id="D03n68" value="**ESTO ES UN FLUJO ORQUESTADO,&lt;br&gt;NO UN AGENTE**&lt;br&gt;&lt;br&gt;Toda solicitud recorre las mismas verificaciones,&lt;br&gt;en el mismo orden, contra la misma politica.&lt;br&gt;Un agente traeria camino no reproducible (rompe V2),&lt;br&gt;latencia variable (rompe el SLA de 48 h) y&lt;br&gt;superficie de inyeccion (el expediente lo redacta un tercero)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="862" y="758" width="381" height="128" as="geometry"/></mxCell>
        <mxCell id="D03n69" value="&lt;b&gt;LA EXCEPCION HONESTA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hay un solo sub-proceso donde el agente si gana&lt;br&gt;segun D5: la SUBSANACION (perseguir el documento&lt;br&gt;que falta). Ahi el camino si varia por caso.&lt;br&gt;&lt;br&gt;**El agente persigue documentos.&lt;br&gt;Nunca decide la autorizacion.**" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1259" y="758" width="381" height="128" as="geometry"/></mxCell>
