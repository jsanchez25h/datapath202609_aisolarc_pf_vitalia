        <mxCell id="D09n101" value="Hito externo o decision pendiente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="1067" width="320" height="20" as="geometry"/></mxCell>
