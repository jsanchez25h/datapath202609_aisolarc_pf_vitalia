        <mxCell id="D03n29" value="&lt;b&gt;V1 · ASIMETRIA DEL ERROR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cuanto cuesta equivocarse y quien lo paga.&lt;br&gt;Si lo paga el afiliado o el regulador,&lt;br&gt;sube el umbral o entra control humano." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="758" width="242" height="128" as="geometry"/></mxCell>
        <mxCell id="D03n30" value="&lt;b&gt;V2 · RECONSTRUIBILIDAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se puede explicar esta decision seis meses&lt;br&gt;despues, con la politica vigente ese dia?&lt;br&gt;Si no, no sirve aunque acierte." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="318" y="758" width="242" height="128" as="geometry"/></mxCell>
