        <mxCell id="D01n43" value="&lt;b&gt;EL AFILIADO / PACIENTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Espera sin saber en que estado esta.&lt;br&gt;Posterga el procedimiento; a veces desiste.&lt;br&gt;Si opera sin autorizacion: codigo AUT-100,&lt;br&gt;paga el 100% de su bolsillo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="64" y="504" width="508" height="130" as="geometry"/></mxCell>
        <mxCell id="D01n44" value="&lt;b&gt;EL MEDICO Y LA CLINICA (prestador)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Le observan la solicitud 24 h despues.&lt;br&gt;Pierde el cupo de quirofano ya reservado.&lt;br&gt;Reprograma agenda y no factura." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="596" y="504" width="508" height="130" as="geometry"/></mxCell>
        <mxCell id="D01n45" value="&lt;b&gt;EL EQUIPO INTERNO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Analistas: 19 min por solicitud, pico&lt;br&gt;de lunes 2.4x. Medicos auditores resolviendo&lt;br&gt;lo que no requiere criterio clinico (55%)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1128" y="504" width="508" height="130" as="geometry"/></mxCell>
