        <mxCell id="D08n17" value="&lt;b&gt;CAPA 7&lt;/b&gt;&lt;br&gt;Prompt Guard 2&lt;br&gt;&lt;br&gt;MALICIOUS / BENIGN&lt;br&gt;&lt;br&gt;_modelo 86M_" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#C55A11;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1260" y="144" width="190" height="96" as="geometry"/></mxCell>
