        <mxCell id="D02n49" value="&lt;b&gt;P7&lt;/b&gt;&lt;br&gt;Politica sin trazar&lt;br&gt;&lt;br&gt;~6 cambios/ano&lt;br&gt;no se reconstruye" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBD9D3;strokeColor=#A61C00;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1434" y="798" width="218" height="96" as="geometry"/></mxCell>
        <mxCell id="D02n50" value="&lt;b&gt;TIEMPO DE TRABAJO&lt;/b&gt;   19 min por solicitud  |  (7 min buscando en el manual)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6DCE5;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="48" y="918" width="389" height="45" as="geometry"/></mxCell>
        <mxCell id="D02n51" value="&lt;b&gt;TIEMPO DE RESPUESTA&lt;/b&gt;   p95 = 6.8 dias  vs  5 dias comprometidos  |  p95 urgentes = 61 h  vs  48 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6DCE5;strokeColor=#1F3864;fontColor=#000000;fontSize=9;fontFamily=Helvetica;align=left;verticalAlign=middle;strokeWidth=1;spacingLeft=6;spacingRight=6;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="453" y="918" width="389" height="45" as="geometry"/></mxCell>
